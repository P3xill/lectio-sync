{
  "manifest_version": 3,
  "name": "Lectio Sync",
  "version": "0.2.1",
  "description": "Privately sync your Lectio timetable to a dedicated Google Calendar.",
  "permissions": ["alarms", "identity", "notifications", "storage"],
  "host_permissions": [
    "https://www.lectio.dk/*",
    "https://www.googleapis.com/*",
    "https://oauth2.googleapis.com/*"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "Lectio Sync",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.lectio.dk/lectio/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "lectio-sync@lectiosync.dk",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["authenticationInfo", "personallyIdentifyingInfo", "websiteContent"]
      }
    }
  }
}
