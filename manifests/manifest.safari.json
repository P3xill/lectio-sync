{
  "manifest_version": 3,
  "name": "Lectio Sync",
  "version": "0.2.3",
  "description": "Privately sync your Lectio timetable to your calendar.",
  "permissions": ["alarms", "storage", "nativeMessaging"],
  "host_permissions": ["https://www.lectio.dk/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Lectio Sync",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.lectio.dk/lectio/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
  }
}
