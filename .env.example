# Chrome Web Store OAuth client. Never put a client secret in the extension.
GOOGLE_OAUTH_CLIENT_ID=replace-with-your-chrome-extension-client-id.apps.googleusercontent.com

# Google Desktop OAuth client used by Firefox's PKCE loopback flow.
# A client secret is optional and must not be bundled or committed.
GOOGLE_FIREFOX_OAUTH_CLIENT_ID=replace-with-your-desktop-client-id.apps.googleusercontent.com
