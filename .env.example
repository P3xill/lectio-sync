# Chrome Web Store OAuth client. Never put a client secret in the extension.
GOOGLE_OAUTH_CLIENT_ID=replace-with-your-chrome-extension-client-id.apps.googleusercontent.com

# Brave workaround: Google Web application OAuth client whose only redirect URI is
# https://YOUR_EXTENSION_ID.chromiumapp.org/
GOOGLE_BRAVE_OAUTH_CLIENT_ID=replace-with-your-brave-web-client-id.apps.googleusercontent.com

# Use brave for an unpacked build loaded in Brave, chrome for Chrome, or auto for
# best-effort runtime detection. MV3 workers may not expose navigator.brave.
CHROMIUM_OAUTH_MODE=auto

# Google Desktop OAuth client used by Firefox's PKCE loopback flow.
# Google currently requires the issued Desktop client secret during token exchange.
# Installed-app secrets are not confidential; keep the real value in ignored .env.
GOOGLE_FIREFOX_OAUTH_CLIENT_ID=replace-with-your-desktop-client-id.apps.googleusercontent.com
GOOGLE_FIREFOX_OAUTH_CLIENT_SECRET=replace-with-your-issued-desktop-client-secret
